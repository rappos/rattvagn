rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // User favorites path: /users/{userId}/favorites/data
    match /users/{userId}/favorites/data {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidId(userId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.stationIds is list
        && request.resource.data.stationIds.size() <= 100
        && request.resource.data.routes is list
        && request.resource.data.routes.size() <= 100;
      allow delete: if isOwner(userId);
    }
  }
}
